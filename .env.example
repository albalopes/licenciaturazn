FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-me-in-production

# MySQL já existente (não é criado pelo Docker Compose deste projeto).
# Use o nome/hostname do container MySQL dentro da database_network.
DATABASE_URL=mysql+pymysql://usuario:senha@mysql:3306/licenciaturazn

# SUAP OAuth2 / API atual
SUAP_BASE_URL=https://suap.ifrn.edu.br
SUAP_AUTH_URL=https://suap.ifrn.edu.br/o/authorize/
SUAP_TOKEN_URL=https://suap.ifrn.edu.br/o/token/
SUAP_API_BASE_URL=https://suap.ifrn.edu.br/api/
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=
SUAP_REDIRECT_URI=https://SEU-DOMINIO/auth/suap/callback
SUAP_SCOPE=read identificacao email
ADMIN_SUAP_USERS=

# Endpoints atuais /api/ (ajuste apenas se a documentação do SUAP mudar)
SUAP_ENDPOINT_ME=rh/eu/
SUAP_ENDPOINT_MY_LINKS=rh/meus-vinculos/
SUAP_ENDPOINT_MY_DATA=rh/meus-dados/
SUAP_ENDPOINT_STUDENT_DATA=ensino/meus-dados-aluno/
SUAP_ENDPOINT_SERVERS=rh/servidores/
SUAP_ENDPOINT_PROJECTS_RESEARCH=pesquisa/projetos/
SUAP_ENDPOINT_PROJECTS_EXTENSION=extensao/projetos/
SUAP_ENDPOINT_PROJECTS_TEACHING=
SUAP_PROJECT_CAMPUS=Natal-Zona-Norte
SUAP_ENDPOINT_PERIODS=ensino/periodos/

# Endpoints de diário mantidos configuráveis
SUAP_ENDPOINT_VIRTUAL_CLASSES=meu-diario/turmas-virtuais/
SUAP_ENDPOINT_REPORT=meu-diario/boletim/{year}/{period}/
SUAP_ENDPOINT_SCHEDULE=meu-diario/horario/{year}/{period}/

# Assistente documental / IA (opcional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_UPLOAD_DIR=knowledge_documents
